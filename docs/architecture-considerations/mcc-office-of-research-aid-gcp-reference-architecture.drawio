        <mxCell id="90" value="C4 container view of the MCC system boundary. Front-end Cloud Run apps never talk to stores directly — all traffic is mediated by Apigee. Agent Orchestrator owns ADK + LangGraph. HITL sits on the readiness → submission path." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1a1a1a;fillColor=#edf2f7;strokeColor=#a0aec0;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="1240" width="2360" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
