        <mxCell id="105" value="Synchronous request/response (solid)   ·   Asynchronous event (dashed)   ·   Trust boundary = MCC VPC + IAP   ·   Default production path = Part C Hybrid (ADK outer + LangGraph inner)   ·   Memorystore Redis is the LangGraph checkpointer   ·   HITL is mandatory before Office of Research Aid / eRA handoff" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1a1a1a;fillColor=#edf2f7;strokeColor=#a0aec0;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="1010" width="2360" height="40" as="geometry" />
        </mxCell>
        <mxCell id="106" value="Happy-path sequence (revision loop)" style="swimlane;startSize=32;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fontColor=#1a1a1a;fillColor=#EDF2F7;strokeColor=#4A5568;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1">
