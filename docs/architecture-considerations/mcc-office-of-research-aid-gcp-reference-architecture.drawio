        <mxCell id="110" value="4. LangGraph planner fans out to specialized agents" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#2B6CB0;fontColor=#1a1a1a;fontSize=11;spacing=4;" vertex="1" parent="1">
