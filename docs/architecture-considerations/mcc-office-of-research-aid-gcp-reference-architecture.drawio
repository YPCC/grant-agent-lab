        <mxCell id="164" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="75" target="92">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="165" value="&lt;b&gt;Architecture decisions (locked)&lt;/b&gt;&#10;• Cloud Run split: FE portals vs BE agent/services&#10;• Shared Cloud SQL (PostgreSQL) for web-app metadata&#10;• BigQuery for analytics / readiness trends&#10;• Memorystore Redis = LangGraph checkpointer + session&#10;• ADK outer orchestration + LangGraph inner revision loop&#10;• Human-in-the-loop review before any Office of Research Aid / eRA handoff" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#fff;strokeColor=#1a365d;fontColor=#1a1a1a;fontSize=11;spacing=4;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="1190" width="520" height="170" as="geometry" />
        </mxCell>
        <mxCell id="166" value="&lt;b&gt;Data plane&lt;/b&gt;&#10;Cloud Storage holds raw packages and parsed text. Document AI extracts layout and entities. Vertex AI Embeddings + Vector Search power FOA / similar-grant RAG. AlloyDB or Cloud SQL is the system of record for users, projects, versions, and workflow status. BigQuery stores scores, usage, and benchmarks. Firestore holds NIH / FOA / Office of Research Aid rule documents." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F8FBFF;strokeColor=#5B8DEF;fontColor=#1a1a1a;fontSize=11;spacing=4;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="1190" width="900" height="170" as="geometry" />
        </mxCell>
        <mxCell id="167" value="&lt;b&gt;Control plane&lt;/b&gt;&#10;IAP + institutional SSO at the edge. Apigee enforces authZ, quotas, and routing. Secret Manager / KMS for credentials. Security Command Center + Cloud Audit Logs for HIPAA/HITRUST evidence. Langfuse traces prompts and tool calls. Vertex AI Evaluation scores agent quality." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FBF7FF;strokeColor=#9B6DCA;fontColor=#1a1a1a;fontSize=11;spacing=4;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1480" y="1190" width="900" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
